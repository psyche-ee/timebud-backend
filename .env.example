# ============================================================================
# TimeBud Django backend — environment configuration
# Copy to .env and adjust values. Never commit the real .env file.
# ============================================================================

# --- Django core -------------------------------------------------------------
# Which settings module to use: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# DEBUG is read as a boolean by django-environ. Keep True only in development.
DEBUG=True

# Comma-separated hosts. Development defaults are already in development.py.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database (PostgreSQL) ---------------------------------------------------
# Used only when DATABASE_URL is not set.
DB_NAME=timebud
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# DATABASE_URL wins over the DB_* values above. Paste the Neon/Render
# connection string here (never commit it); sslmode/channel_binding in the
# URL are forwarded to psycopg automatically.
# DATABASE_URL=postgresql://user:password@host/timebud?sslmode=require&channel_binding=require

# Keep pooled/serverless connections short-lived (Neon, pgbouncer).
DB_CONN_MAX_AGE=0

# --- CORS / frontend ---------------------------------------------------------
# Existing React frontend origins. Comma-separated, no trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://timebud-frontend.vercel.app

# Used by password reset emails (Laravel hardcoded localhost:5173 previously).
FRONTEND_URL=http://localhost:5173

# --- Timezone ----------------------------------------------------------------
# Matches Laravel's config/app.php 'timezone' => 'Asia/Manila'
TIME_ZONE=Asia/Manila

# --- Email (password reset) --------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@timebud.local

# --- Production-only security settings --------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
